rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Daily Stats Collection
    match /dailyStats/{statId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Blocked Logs Collection
    match /blockedLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Multi-Device Pairing Sessions (Restricted to authenticated users with valid code and expiresAt TTL)
    match /pairingSessions/{pairingCode} {
      allow read: if isAuthenticated() && isValidId(pairingCode) && 
        (resource == null || resource.data.expiresAt == null || request.time < resource.data.expiresAt);
      allow create, update: if isAuthenticated() && isValidId(pairingCode) && 
        (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp);
      allow delete: if isAuthenticated() && isValidId(pairingCode);
    }
  }
}
