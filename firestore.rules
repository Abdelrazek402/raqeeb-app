rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPairingCode(id) {
      return id is string && id.matches('^RQ-[A-Za-z0-9_\\-]{4,32}$');
    }

    function ownsActivePairingSession() {
      return isAuthenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;
    }

    function createsOwnedPairingSession() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.time < request.resource.data.expiresAt;
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Daily Stats Collection
    match /dailyStats/{statId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Blocked Logs Collection
    match /blockedLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Pairing codes identify a session; authentication and immutable ownership authorize access.
    match /pairingSessions/{pairingCode} {
      allow read: if isValidPairingCode(pairingCode) && ownsActivePairingSession();
      allow create: if isValidPairingCode(pairingCode) && createsOwnedPairingSession();
      allow update: if isValidPairingCode(pairingCode)
        && ownsActivePairingSession()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.expiresAt is timestamp
        && request.time < request.resource.data.expiresAt
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow delete: if isValidPairingCode(pairingCode)
        && isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}
