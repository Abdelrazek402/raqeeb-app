@echo off
chcp 65001 >nul
title تشغيل رَقِيب - الرفيق الرقمي الواعي
color 0B

echo ======================================================
echo           مشروع رَقِيب - الرفيق الرقمي الواعي
echo        تشغيل لوحة التحكم المباشرة (بدون سيرفر)
echo ======================================================
echo.

cd /d "%~dp0"

echo [*] جاري فتح لوحة تحكم رَقِيب مباشرة في متصفحك...
echo [*] النسخة تعمل ذاتياً 100% أوفلاين بدون أي سيرفر أو متطلبات خارجية.
echo.

if exist "%~dp0تشغيل_مباشر_بدون_سيرفر.html" (
    start "" "%~dp0تشغيل_مباشر_بدون_سيرفر.html"
    echo [+] تم فتح البرنامج بنجاح.
) else (
    start "" "%~dp0index.html"
    echo [+] تم فتح البرنامج بنجاح.
)

echo.
echo ======================================================
echo  إذا كنت تريد تفعيل درع الحماية الشاملة على الويندوز:
echo  انقر بزر الفأرة الأيمن على:
echo  "تثبيت_درع_رقيب_على_ويندوز.bat"
echo  واختر (تشغيل كمسؤول / Run as administrator).
echo ======================================================
echo.
timeout /t 5 >nul
exit /b
