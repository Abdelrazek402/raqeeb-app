{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "package:extension": "node scripts/package-extension.js",
    "prepare:windows": "node scripts/prepare-windows-assets.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test:firestore-rules": "firebase emulators:exec --project demo-raqeeb-rules --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:anti-fake": "node --test tests/anti-fake.test.mjs",
    "test:extension": "node --test tests/extension-rules.test.mjs",
    "test:analytics-data": "node --import tsx --test tests/analytics-data.test.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "8.4.3",
    "@capacitor/core": "^8.5.2",
