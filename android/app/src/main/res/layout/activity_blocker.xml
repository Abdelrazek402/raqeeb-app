<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blockerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#042f2e"
    android:padding="32dp">

    <!-- Top Badge / Icon -->
    <TextView
        android:id="@+id/tvShieldIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="🛡️"
        android:textSize="54sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Application Title -->
    <TextView
        android:id="@+id/tvBlockerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="رَقِيب | درع الحماية وغض البصر"
        android:textColor="#2dd4bf"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvShieldIcon" />

    <!-- Calming Ayah Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAyah"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="#064e3b"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBlockerTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvAyahText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="قال تعالى:\n{أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ}"
                android:textColor="#f0fdfa"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAyahSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="[سورة العلق: 14]"
                android:textColor="#99f6e4"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Calming Mindfulness & Blocked App Message -->
    <TextView
        android:id="@+id/tvBlockedPackageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="تم إيقاف هذا التطبيق لحفظ وقتك وغض بصرك ومراقبة نيتك.\nاستعن بالله واذكر ربك: أستغفر الله العظيم وأتوب إليه."
        android:textColor="#ccfbf1"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardAyah" />

    <!-- Go Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoBack"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#0d9488"
        android:text="أستغفر الله العظيم (العودة للرئيسية)"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
